node_modules
**/node_modules
**/.git
dist
**/dist
.env
.env.*
!.env.example
*.log
coverage
.turbo
**/*.tsbuildinfo
.implement-plan-state.json

# Documentation and planning (not needed in Docker image)
*.md
!packages/*/README.md
docs/
reference/
.claude/
.github/
scripts/
# Python ingest scripts are shipped in the financial-ingest sidecar image.
# Negations here make them available to that build context.
!scripts/financial-pipeline.py
!scripts/utility-pipeline.py
!scripts/lib/
!scripts/lib/**
# actual-ingest sidecar (#311) — re-include exactly what docker/actual-sidecar/
# Dockerfile COPYs (NOT test/ or node_modules; node_modules stays excluded above).
# Without these, `scripts/` above hides scripts/actual and the COPY fails at build.
!scripts/actual/package.json
!scripts/actual/package-lock.json
!scripts/actual/actual-daily.mjs
!scripts/actual/lib/
!scripts/actual/lib/**

# Test files (not needed in production image)
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/vitest.config.ts
**/vitest.config.*.ts
docker-compose*.yml
