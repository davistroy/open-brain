# SW5-L13: wrangler's dependency tree (esbuild/miniflare peer ranges) does not
# yet cover the workers-types/typescript majors this worker has been bumped to
# by Dependabot. Without this, `npm ci` fails with ERESOLVE before CI can even
# reach tsc/vitest. This directory is a standalone npm project outside the
# pnpm workspace, so pnpm's `dependencies-meta`/hoisting flags don't apply here.
legacy-peer-deps=true
