# Open Brain — Environment Configuration
# All secrets are stored in Bitwarden Secrets Manager
# Retrieve with: bws secret get <secret-id>
# See CLAUDE.md for the secrets management policy
#
# This file documents NON-SECRET config (safe defaults, dev placeholders).
# Genuine secrets (API keys, tokens, passwords) live in `deploy/.env.secrets.template`
# + `scripts/lib/secrets-map.sh` (the BWS-name -> ENV-var map), NOT here —
# see the "3-step lockstep for adding a new secret" rule in CLAUDE.md. GITEA_TOKEN,
# CLOUDFLARE_TUNNEL_TOKEN, PUSHOVER_*, VOICE_CAPTURE_SECRET, etc. are documented
# there, not duplicated below.
#
# Fail-closed convention: docker-compose.yml uses `${VAR:?message}` (not `:-default`)
# for exactly two vars — POSTGRES_PASSWORD and REDIS_PASSWORD — compose REFUSES to
# start any service without them. Every other var below uses `:-default` (optional,
# safe fallback) and is annotated as such.

# ============================================================
# DATABASE (dev defaults — non-sensitive, matches docker-compose.yml)
# ============================================================
POSTGRES_URL=postgresql://openbrain:openbrain_dev@localhost:5432/openbrain
# POSTGRES_PASSWORD: FAIL-CLOSED — docker-compose.yml uses ${POSTGRES_PASSWORD:?...}
# and will refuse to start the postgres service without it. Real value in Bitwarden
# (open-brain-postgres-password). Used to build the in-Docker POSTGRES_URL
# (postgresql://openbrain:${POSTGRES_PASSWORD}@postgres:5432/openbrain) — distinct
# from the plain local-dev POSTGRES_URL above.
POSTGRES_PASSWORD=

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD: FAIL-CLOSED — docker-compose.yml uses ${REDIS_PASSWORD:?...} and
# will refuse to start the redis service without it. Real value in
# Bitwarden (open-brain-redis-password); generate with `openssl rand -hex 32`.
# In Docker, REDIS_URL is built as redis://:${REDIS_PASSWORD}@redis:6379.
REDIS_PASSWORD=

# ============================================================
# TAILSCALE (core-api MCP exposure — ADR-0002)
# ============================================================
# core-api publishes on 127.0.0.1 AND this Tailscale IP (for OpenClaw MCP).
# Defaults to 100.101.61.122 in compose; override per-host if the IP differs.
TAILSCALE_IP=100.101.61.122

# ============================================================
# OpenAI API (retrieve from Bitwarden)
# ============================================================
OPENAI_API_KEY=get-from-bitwarden
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# SLACK (retrieve from Bitwarden)
# ============================================================
SLACK_BOT_TOKEN=get-from-bitwarden
SLACK_APP_TOKEN=get-from-bitwarden
# Note: SLACK_SIGNING_SECRET is NOT needed for Socket Mode (only for HTTP webhooks)

# Slack User Token — required for channel cleanup (F35)
# This is an xoxp-... user token (NOT bot token) with scopes: channels:history, chat:write
# Bot tokens can only delete messages the bot sent; user tokens can delete any message.
# Create in Slack app config under "User Token Scopes", store in Bitwarden: dev/open-brain/slack-user-token
SLACK_USER_TOKEN=get-from-bitwarden

# ============================================================
# AI MODEL ALIASES (configured on llm.k4jda.net)
# ============================================================
AI_MODEL_FAST=fast
AI_MODEL_SYNTHESIS=synthesis
AI_MODEL_GOVERNANCE=governance
AI_MODEL_INTENT=intent
AI_EMBEDDING_MODEL=spark-qwen3-embedding-4b

# ============================================================
# CORE API
# ============================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# ADMIN API (protects destructive endpoints: reset-data, config/reload)
# Falls back to MCP_BEARER_TOKEN if not set. Fail-closed: rejects all if neither is set.
# ============================================================
ADMIN_API_KEY=get-from-bitwarden

# ============================================================
# MCP
# ============================================================
MCP_BEARER_TOKEN=get-from-bitwarden

# ============================================================
# OBSERVABILITY (PE-L1 / SW5-L14, Entry 8.5)
# ============================================================
# LOKI_URL: target for the Docker `loki` log driver (all compose services log here).
# Optional — docker-compose.yml falls back to ${LOKI_URL:-http://localhost:3100/loki/api/v1/push}.
# On the homeserver this resolves via the daemon's log-driver networking (see
# CLAUDE.md "Homeserver deploy mechanics"); Loki plugin must be pre-installed on
# the Docker host once (`docker plugin install grafana/loki-docker-driver:latest ...`).
LOKI_URL=http://localhost:3100/loki/api/v1/push

# PUSHGATEWAY_URL: workers push outbound-dependency + skill metrics here (no
# scrape registry in that process). Optional — packages/workers/src/lib/push-metrics.ts
# falls back to http://pushgateway:9091 (the observability compose project's
# service name) when unset. Only needs overriding for local dev against a
# differently-named/ported Pushgateway.
PUSHGATEWAY_URL=http://pushgateway:9091

# STAGING_DIR: host path bind-mounted read-only into faster-whisper for staged
# audio files. Optional — docker-compose.yml falls back to
# ${STAGING_DIR:-/mnt/user/openbrain/staging} (Unraid-specific default; irrelevant
# outside that host).
STAGING_DIR=/mnt/user/openbrain/staging

# WIKI_REPO_URL: git remote workers clones/pushes for wiki-ingest. Hardcoded
# directly in docker-compose.yml's `workers` service (not `${WIKI_REPO_URL}`
# interpolated), so this entry only matters for running workers OUTSIDE Docker
# (`pnpm --filter @open-brain/workers dev`). Unset entirely = wiki-ingest skips
# (workers/src/jobs/ingestion-worker.ts checks `!!process.env.WIKI_REPO_URL`).
WIKI_REPO_URL=http://localhost:3000/davistroy/open-brain-wiki.git

# GITEA_TOKEN, CLOUDFLARE_TUNNEL_TOKEN: genuine secrets — see
# deploy/.env.secrets.template + scripts/lib/secrets-map.sh, NOT this file.
