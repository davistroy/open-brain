{
  "name": "@open-brain/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests --pool forks",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@azure/msal-node": "^2.16.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^9.14.0",
    "js-yaml": "^4.1.1",
    "openai": "^4.98.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "simple-git": "^3.36.0",
    "unified": "^11.0.5",
    "xss": "^1.0.15",
    "zod": "^3.23.0"
  }
}
