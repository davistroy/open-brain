{
  "name": "open-brain",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "echo 'Run dev from individual packages'",
    "test": "pnpm -r test",
    "test:validation": "vitest run --config vitest.config.validation.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18 - 19",
        "react-dom": "18 - 19"
      },
      "ignoreMissing": [
        "expo-constants"
      ]
    },
    "overrides": {
      "axios": "1.16.0",
      "@xmldom/xmldom": "0.8.13",
      "form-data": "4.0.6",
      "lodash": "4.18.0",
      "path-to-regexp@^8.0.0": "8.4.0",
      "fast-uri": "3.1.2",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "ws@^6.0.0": "6.2.4",
      "ws@^7.0.0": "7.5.11",
      "ws@^8.0.0": "8.21.0",
      "shell-quote": "1.8.4",
      "undici": "6.27.0"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2",
    "tsx": "^4.7.0",
    "vitest": "^2.1.9"
  }
}
