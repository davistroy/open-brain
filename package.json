{
  "name": "open-brain",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "echo 'Run dev from individual packages'",
    "test": "pnpm -r test",
    "test:validation": "vitest run --config vitest.config.validation.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18 - 19",
        "react-dom": "18 - 19"
      },
      "ignoreMissing": [
        "expo-constants"
      ]
    }
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^1.6.0"
  }
}
