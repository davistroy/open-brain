FROM python:3.12-slim

# Install system tools: LibreOffice (doc conversion), poppler (pdftotext), tesseract (OCR)
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      libreoffice-writer \
      poppler-utils \
      tesseract-ocr \
      tesseract-ocr-eng && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python extraction libraries
RUN pip install --no-cache-dir \
    pymupdf \
    python-docx \
    python-pptx \
    openpyxl \
    xlrd \
    requests

COPY ingest-repair.py /scripts/ingest-repair.py

ENTRYPOINT ["python3", "-u", "/scripts/ingest-repair.py"]
