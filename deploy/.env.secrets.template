# =============================================================================
# Open Brain — Secrets Template
# =============================================================================
# Copy to .env.secrets (project root, next to docker-compose.yml) and populate
# from Bitwarden Secrets Manager:
#
#   bws secret list | grep <KEY_NAME>
#   bws secret get <SECRET_ID> | jq -r .value
#
# NEVER commit .env.secrets — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by: postgres, core-api, workers (via POSTGRES_URL connection string)
# Bitwarden: open-brain-postgres-password
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (BullMQ broker + cache)
# -----------------------------------------------------------------------------
# Used by: redis (--requirepass), core-api, workers, slack-bot (REDIS_URL).
# SEC-08 (ADR-0002): Redis is no longer password-less. Generate with
#   openssl rand -hex 32   (hex only — safe inside redis:// URLs and the healthcheck)
# Bitwarden: open-brain-redis-password
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# OpenAI API (LLM inference + embeddings)
# -----------------------------------------------------------------------------
# Used by: core-api, workers, slack-bot, voice-capture
# All AI requests route through api.openai.com/v1
# Bitwarden: open-brain-openai-api-key
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Jetson T1 (local classification LLM)
# -----------------------------------------------------------------------------
# Used by: workers + core-api (via the t1_jetson tier's api_key_env in
#          config/ai-routing.yaml) and scripts/email-pipeline.py on obvm.
# The Jetson requires a bearer token on /chat/completions. Note /v1/models stays
# open, so an unauthenticated probe makes the endpoint look healthy — it is not.
# Without this, the whole T1 tier 401s silently and classification degrades (#283).
# Bitwarden: dev/jetson/llm-api-key
JETSON_API_KEY=

# -----------------------------------------------------------------------------
# MCP / Admin Authentication
# -----------------------------------------------------------------------------
# Used by: core-api (Bearer token for MCP endpoint + admin endpoints)
# Bitwarden: open-brain-mcp-api-key
MCP_API_KEY=

# Used by: core-api (admin endpoint protection; falls back to MCP_BEARER_TOKEN)
# Bitwarden: open-brain-admin-api-key  (or reuse MCP_API_KEY)
ADMIN_API_KEY=

# Used by: core-api (Bearer token for mobile app clients — iOS/Android)
# Bitwarden: MOBILE_API_KEY  (bare key — corrected from dev/open-brain/mobile-api-key, #340)
MOBILE_API_KEY=

# Used by: voice-capture (enforces Bearer on POST /api/capture) + core-api
# (forwards it upstream from the /api/v1/voice-captures proxy). INT-M5 / Phase 8.1.
# Two-phase rollout: leave UNSET (warn-and-allow) until the iOS Shortcut + mobile
# clients send the Bearer, then set it to enforce. Generate: openssl rand -hex 32
# Bitwarden: dev/open-brain/voice-capture-secret  (FORWARD-DECLARED — item not yet created; create under this exact key on rollout, #340)
VOICE_CAPTURE_SECRET=

# Used by: ingest sidecars (financial/utility) — bearer token core-api & workers
# present to the sidecar /process HTTP trigger (constant-time compare, NOT HMAC).
# Referenced in 14 files but was previously wired to NEITHER this template NOR
# secrets-map.sh, so a DR rebuild started the sidecars unauthenticated (#300).
# A generated shared secret: `openssl rand -hex 32`. Host cron docker-exec's the
# pipelines directly and does NOT need this; only the HTTP dispatch path does.
# Bitwarden: open-brain-ingest-trigger-secret  (item EXISTS — corrected from dev/open-brain/..., #340/OA-26)
INGEST_TRIGGER_SECRET=

# Used by: actual-ingest sidecar (#311) — the Actual Budget daily job. All three
# arrive via env_file: .env.secrets; none may appear in docker-compose.yml.
# Bitwarden: project `ai-work`, item "Actual Budget — My Finances".
# BWS `.key` names CONFIRMED 2026-07-17 (#340): actual-budget-password /
# actual-budget-sync-id / actual-budget-server-url (project `ai-work`).
# ⚠️ DATA RULE: never write the actual VALUES into any committed file. The sync
# ID, server URL, and password are financial identifiers — BWS + host-only .env.secrets only.
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_SERVER_URL=

# -----------------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------------
# Used by: slack-bot
# Bitwarden: open-brain-slack-bot-token
SLACK_BOT_TOKEN=

# Used by: slack-bot (Socket Mode)
# Bitwarden: open-brain-slack-app-token
SLACK_APP_TOKEN=

# Used by: core-api (xoxp-... user token for channel cleanup; channels:history, chat:write scopes)
# Bitwarden: slack-user-token  (bare key — corrected from open-brain-slack-user-token, #340)
SLACK_USER_TOKEN=

# -----------------------------------------------------------------------------
# Pushover Notifications
# -----------------------------------------------------------------------------
# Used by: workers (skill notifications, pipeline-health alerts)
# Bitwarden: open-brain-pushover-app-token
PUSHOVER_APP_TOKEN=

# Used by: workers
# Bitwarden: open-brain-pushover-user-key
PUSHOVER_USER_KEY=

# Used by: voice-capture (legacy voice notification)
# Bitwarden: open-brain-pushover-token  (may be same as PUSHOVER_APP_TOKEN)
PUSHOVER_TOKEN=

# Used by: voice-capture (legacy voice notification)
# Bitwarden: open-brain-pushover-user  (may be same as PUSHOVER_USER_KEY)
PUSHOVER_USER=

# -----------------------------------------------------------------------------
# Gitea (Wiki Repository)
# -----------------------------------------------------------------------------
# Used by: core-api, workers (WikiGitService token-based HTTP auth)
# Bitwarden: dev/open-brain/gitea-token
GITEA_TOKEN=

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# -----------------------------------------------------------------------------
# Used by: cloudflared (brain.troy-davis.com tunnel — reads TUNNEL_TOKEN via env_file)
# Bitwarden: open-brain-cloudflare-tunnel-token
# #281/D145: env var renamed CLOUDFLARE_TUNNEL_TOKEN -> TUNNEL_TOKEN (cloudflared reads
# TUNNEL_TOKEN directly; the old interpolation `TUNNEL_TOKEN: ${CLOUDFLARE_TUNNEL_TOKEN}`
# was removed from docker-compose.yml). Nothing else references the old name.
TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Deepgram (Speech-to-text)
# -----------------------------------------------------------------------------
# Used by: scripts/deepgram-spike.py (offline STT benchmark spike, #250/#255)
# Optional — no longer tied to a running service (voice-pipecat consumer removed #298); the spike script is run manually
# Bitwarden: OPENCLAW_DEEPGRAM_API_KEY  (shared with OpenClaw for cost tracking)
#   bws secret list | grep OPENCLAW_DEEPGRAM_API_KEY
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Anthropic / Claude API (optional routing tier)
# -----------------------------------------------------------------------------
# Used by: optional Anthropic routing tier (ai-routing.yaml); voice-pipecat consumer removed #298
# Optional — only needed if an anthropic-provider tier is enabled in ai-routing.yaml
# Bitwarden: OPENCLAW_ANTHROPIC_API_KEY  (shared with OpenClaw for cost tracking)
#   bws secret list | grep OPENCLAW_ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Grafana (Observability Stack — STANDALONE `observability` project post-ADR-0004)
# -----------------------------------------------------------------------------
# NOT consumed by open-brain: there is no grafana service in this repo's compose.
# REMOVED from scripts/lib/secrets-map.sh (#340/WI-5.5) — it belongs to the
# observability project. Kept here only as a documented placeholder; leave UNSET.
# Bitwarden: GRAFANA_ADMIN_PASSWORD (observability project's item, not open-brain's)
GRAFANA_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Bitwarden Secrets Manager — bootstrap token (RC-13)
# -----------------------------------------------------------------------------
# Used by: workers (the monthly `secret-rotation` skill shells out to `bws secret
# list` for its 90-day staleness check + Pushover alert).
#
# BOOTSTRAP EXCEPTION — do NOT add this to scripts/lib/secrets-map.sh. Every other
# secret in this file is fetched FROM Bitwarden by load-secrets.sh, but this token
# IS the credential that authenticates to Bitwarden — it cannot fetch itself
# (chicken-and-egg; load-secrets.sh would exit 2 refusing a partial file). Populate
# it BY HAND on the workers host (from your Bitwarden machine-account access token).
# It reaches the workers container via `env_file: .env.secrets`, so this template
# entry is sufficient — no explicit docker-compose env entry is required.
# Leave UNSET to disable the staleness check (the skill logs a warning and skips).
BWS_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Outbound Email (Himalaya SMTP)
# -----------------------------------------------------------------------------
# Used by: workers (email draft sending)
# All are required for outbound email; omit all to disable. FORWARD-DECLARED —
# the BWS items are not created yet (#340). secrets-map.sh expects 4 separate keys:
# open-brain-smtp-{host,user,pass,from}; create them under those exact names.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
